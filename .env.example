# Ledgerly API Base URL (Configured when Amazon API Gateway is deployed)
VITE_API_BASE_URL=

# WhatsApp Cloud API (Meta Graph API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=ledgerly_verify_2026
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v18.0
DEFAULT_SHOP_ID=shop001
SHOP_PHONE_MAP={"YOUR_PHONE_NUMBER_ID":"shop001"}

# Voice Transcription (AWS Transcribe + Whisper fallback for 23 Indian languages)
TRANSCRIBE_S3_BUCKET=ledgerly-whatsapp-audio
TRANSCRIBE_LANGUAGE=auto
# Supported: auto (detect among 12 AWS langs) or explicit: en-IN, hi-IN, bn-IN, gu-IN, kn-IN, ml-IN, mr-IN, pa-IN, ta-IN, te-IN, or-IN, ne-NP
# Whisper-only (needs Whisper provider): as, sa, sd, ur; Gap fallback: brx/bodo, doi/dogri, ks, kok, mai, mni, sat -> hi-IN/bn-IN/ur
TRANSCRIBE_PROVIDER=aws
MAX_VOICE_BYTES=10485760
SUPPORTED_AWS_LANGS=en-IN,hi-IN,bn-IN,gu-IN,kn-IN,ml-IN,mr-IN,pa-IN,ta-IN,te-IN,or-IN,ne-NP

# Whisper Fallback (for as, sa, sd, ur, or fine-tune; also gap fallback)
# Choose one: huggingface, openai, selfhosted (or leave blank for AWS-only)
WHISPER_PROVIDER=
WHISPER_ENDPOINT_URL=
HF_TOKEN=
OPENAI_API_KEY=

# WhatsApp Send Retries (Exponential backoff for transient 429/5xx Graph API errors)
WHATSAPP_SEND_MAX_RETRIES=2
WHATSAPP_SEND_RETRY_BACKOFF_BASE=0.2

# DynamoDB Data Layer (Deterministic ledger)
CUSTOMERS_TABLE=Customers
TRANSACTIONS_TABLE=Transactions
# DYNAMODB_ENDPOINT_URL=http://localhost:8000 # for local testing

# Bedrock (Multilingual 23 Indian languages + English)
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1
